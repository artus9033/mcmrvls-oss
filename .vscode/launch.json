  "version": "0.2.0",
  "configurations": [
    {
      "name": "server live",
      "type": "debugpy",
      "request": "launch",
      "program": ".",
      "cwd": "${workspaceFolder}/server"
    },
    {
      "name": "server playback (still)",
      "type": "debugpy",
      "request": "launch",
      "program": ".",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "RUN_FROM_PLAYBACK_DIRECTORY": "still"
      }
    },
    {
      "name": "server playback (moving-recalculate)",
      "type": "debugpy",
      "request": "launch",
      "program": ".",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "RUN_FROM_PLAYBACK_DIRECTORY": "moving-recalculate"
      }
    },
    {
      "name": "server playback (moving-recalculate-2-frames)",
      "type": "debugpy",
      "request": "launch",
      "program": ".",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "RUN_FROM_PLAYBACK_DIRECTORY": "moving-recalculate-2-frames"
      }
    }
  ]
}
