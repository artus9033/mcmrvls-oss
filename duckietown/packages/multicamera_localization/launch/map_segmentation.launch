<launch>
    <!-- M-C M-R VLS Server IP address -->
    <arg name="server_address" doc="IP address for the multicamera localization server" default="localhost" />
    <!-- M-C M-R VLS Server port -->
    <arg name="server_port" doc="Port for the multicamera localization server" default="6001" />

    <group ns="mcmrvls">
        <node name="multicamera_localization_map_segmentation_node" pkg="multicamera_localization" type="map_segmentation_node.py" output="screen">
            <param name="server_address" value="$(arg server_address)"/>
            <param name="server_port" value="$(arg server_port)"/>
        </node>
    </group>
</launch>
